import java.util.Arrays;

class Solution {
    public String largestNumber(int[] nums) {
        // Convert the array of integers into an array of strings
        String[] s = new String[nums.length];
        for (int i = 0; i < nums.length; i++) {
            s[i] = String.valueOf(nums[i]);
        }
        
        // Sort strings using a custom comparator based on concatenated results
        Arrays.sort(s, (a, b) -> (b + a).compareTo(a + b));
        
        // Edge case: if the highest number is "0", the entire array is zeros
        if (s[0].equals("0")) {
            return "0";
        }
        
        // Concatenate all sorted string components
        StringBuilder sb = new StringBuilder();
        for (String str : s) {
            sb.append(str);
        }
        
        return sb.toString();
    }
}
