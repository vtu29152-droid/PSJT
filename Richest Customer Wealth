import java.util.Arrays;

class Solution {
    public int minimumMountainRemovals(int[] nums) {
        int n = nums.length;
        int[] left = new int[n];
        int[] right = new int[n];
        
        Arrays.fill(left, 1);
        Arrays.fill(right, 1);
        
        // Step 1: Compute LIS ending at each index (left to right)
        for (int i = 1; i < n; i++) {
            for (int j = 0; j < i; j++) {
                if (nums[i] > nums[j]) {
                    left[i] = Math.max(left[i], left[j] + 1);
                }
            }
        }
        
        // Step 2: Compute LDS starting at each index (right to left)
        for (int i = n - 2; i >= 0; i--) {
            for (int j = i + 1; j < n; j++) {
                if (nums[i] > nums[j]) {
                    right[i] = Math.max(right[i], right[j] + 1);
                }
            }
        }
        
        int maxMountainLength = 0;
        
        // Step 3: Find the maximum valid mountain length
        for (int i = 0; i < n; i++) {
            // A valid peak must have a slope on both sides
            if (left[i] > 1 && right[i] > 1) {
                maxMountainLength = Math.max(maxMountainLength, left[i] + right[i] - 1);
            }
        }
        
        // Step 4: Minimum removals = total length - maximum mountain length
        return n - maxMountainLength;
    }
}
